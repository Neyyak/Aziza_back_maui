
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp2.MainPage"
    Title="Главная"
    BackgroundColor="#0A0A0A">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,24,20,32"
            Spacing="25">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        HeightRequest="56"
                        WidthRequest="56">

                    <Image Source="profile.png"
                           Aspect="AspectFill"/>
                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="3">

                    <Label Text="REESTR"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Площадка объявлений"
                           FontSize="13"
                           TextColor="#999999"/>

                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="+ Добавить"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#287CF5"
                        CornerRadius="12"
                        Padding="15,12"
                        VerticalOptions="Center"/>

            </Grid>
            <Border BackgroundColor="#171717"
                    Stroke="#343434"
                    StrokeShape="RoundRectangle 14"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Label Grid.Column="0"
                           Text="⌕"
                           FontSize="28"
                           TextColor="#A1A1AA"
                           VerticalOptions="Center"/>

                    <Entry Grid.Column="1"
                           Placeholder="Найти объявление..."
                           PlaceholderColor="#777777"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           HeightRequest="52"/>

                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="5">

                    <Label Text="Объявления"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Актуальные предложения"
                           FontSize="14"
                           TextColor="#999999"/>

                </VerticalStackLayout>

                <Label Grid.Column="1"
                       Text="Все"
                       TextColor="#3B82F6"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>

            </Grid>
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="12">
                <Border Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="#171717"
                        Stroke="#333333"
                        StrokeShape="RoundRectangle 18"
                        Padding="10">

                    <VerticalStackLayout Spacing="12">

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="135">

                            <Image Source="channels4_profile.jpg"
                                   Aspect="AspectFill"/>

                        </Border>

                        <VerticalStackLayout Spacing="7">

                            <Label Text="Ищим Ceo Nvdia"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="пачка риса"
                                   TextColor="#3B82F6"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <BoxView HeightRequest="1"
                                     Color="#333333"
                                     Margin="0,5"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="Ташкент"
                                       TextColor="#999999"
                                       FontSize="12"/>

                                <Label Grid.Column="1"
                                       Text="Сегодня"
                                       TextColor="#777777"
                                       FontSize="11"/>

                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0"
                        Grid.Column="2"
                        BackgroundColor="#171717"
                        Stroke="#333333"
                        StrokeShape="RoundRectangle 18"
                        Padding="10">

                    <VerticalStackLayout Spacing="12">

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="135">

                            <Image Source="channels4_profile.jpg"
                                   Aspect="AspectFill"/>

                        </Border>

                        <VerticalStackLayout Spacing="7">

                            <Label Text="Ищим Ceo Nvdia"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="пачка риса"
                                   TextColor="#3B82F6"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <BoxView HeightRequest="1"
                                     Color="#333333"
                                     Margin="0,5"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="Ташкент"
                                       TextColor="#999999"
                                       FontSize="12"/>

                                <Label Grid.Column="1"
                                       Text="Сегодня"
                                       TextColor="#777777"
                                       FontSize="11"/>

                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>


                <Border Grid.Row="1"
                        Grid.Column="0"
                        BackgroundColor="#171717"
                        Stroke="#333333"
                        StrokeShape="RoundRectangle 18"
                        Padding="10">

                    <VerticalStackLayout Spacing="12">

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="135">

                            <Image Source="channels4_profile.jpg"
                                   Aspect="AspectFill"/>

                        </Border>

                        <VerticalStackLayout Spacing="7">

                            <Label Text="Ищим Ceo Nvdia"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="пачка риса"
                                   TextColor="#3B82F6"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <BoxView HeightRequest="1"
                                     Color="#333333"
                                     Margin="0,5"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="Ташкент"
                                       TextColor="#999999"
                                       FontSize="12"/>

                                <Label Grid.Column="1"
                                       Text="Сегодня"
                                       TextColor="#777777"
                                       FontSize="11"/>

                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1"
                        Grid.Column="2"
                        BackgroundColor="#171717"
                        Stroke="#333333"
                        StrokeShape="RoundRectangle 18"
                        Padding="10">

                    <VerticalStackLayout Spacing="12">

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="135">

                            <Image Source="channels4_profile.jpg"
                                   Aspect="AspectFill"/>

                        </Border>

                        <VerticalStackLayout Spacing="7">

                            <Label Text="Ищим Ceo Nvdia"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="пачка риса"
                                   TextColor="#3B82F6"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <BoxView HeightRequest="1"
                                     Color="#333333"
                                     Margin="0,5"/>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="Ташкент"
                                       TextColor="#999999"
                                       FontSize="12"/>

                                <Label Grid.Column="1"
                                       Text="Сегодня"
                                       TextColor="#777777"
                                       FontSize="11"/>

                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
