<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp2.MainViewModels"
             x:Class="MauiApp2.MainPage">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel/>
    </ContentPage.BindingContext>
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto"
                BackgroundColor="#0A0A0A"
                Padding="20"
                RowSpacing="20">
            <Border Grid.Row="0"
                    Stroke="Gray"
                    StrokeShape="RoundRectangle 10"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add New Student"
                            TextColor="white"
                            FontSize="30"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>
                    <Border Grid.Row="0"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            Padding="15">
                        <Entry BackgroundColor="#0A0A0A"
                                Placeholder="Surname*"
                                Text="{Binding NewSurname}"/>
                    </Border>
                    <Border Grid.Row="0"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            Padding="15">
                        <Entry BackgroundColor="#0A0A0A"
                                Placeholder="Name*"
                                Text="{Binding NewName}"/>
                    </Border>
                    <Border Grid.Row="0"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            Padding="15">
                        <Entry BackgroundColor="#0A0A0A"
                                Placeholder="Patronymic"
                                Text="{Binding NewPatronymic}"/>
                    </Border>

                    <Grid RowDefinitions="Auto"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                Padding="15">
                            <Entry  Placeholder="Year"
                                    TextColor="#EDEDED"
                                    Text="{Binding NewYear}"
                                    Keyboard="Numeric"/>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                Padding="15">
                            <Entry TextColor="#EDEDED"
                                    Placeholder="Group"
                                    Text="{Binding NewGroup}"
                                    Keyboard="Numeric"/>
                        </Border>
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                            TextColor="Red"
                            FontSize="12"/>
                    <Grid HeightRequest="50">

                        <Button
                            Text="Add Student"
                            BackgroundColor="#3B82F6"
                            TextColor="#FFFFFF"
                            FontSize="18"
                            CornerRadius="10"
                            Padding="15,0"
                            Command="{Binding AddStudentCommand}"/>

                        <Path
                            Data="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"
                            Fill="White"
                            Aspect="Uniform"
                            WidthRequest="20"
                            HeightRequest="20"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,15,0"
                            InputTransparent="True"/>

                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Grid.Row="1"
                    Text="Students List"
                    FontSize="18"
                    FontAttributes="Bold"/>
            <CollectionView Grid.Row="2"
                    ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeShape="RoundRectangle 8"
                                Padding="10"
                                Margin="0,5">
                            <Grid ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0"
                                        Spacing="5">
                                    <Label Text="{Binding Surname}"
                                            FontSize="16"
                                            FontAttributes="Bold"/>
                                    <Label Text="{Binding Name}"
                                            FontSize="14"/>
                                    <Label Text="{Binding Patronymic}"
                                            FontSize="12"
                                            TextColor="Gray"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                        Spacing="5"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding Year, StringFormat='Year: {0}'}"
                                            FontSize="12"/>
                                    <Label Text="{Binding Group, StringFormat='Group: {0}'}"
                                            FontSize="12"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No students added yet"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="Gray"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </ScrollView>

</ContentPage>