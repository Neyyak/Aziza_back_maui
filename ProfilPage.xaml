<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp2.ProfilPage"
    Title="Профиль"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto"
          Padding="20,20,20,24">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="28">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="14"
                      Padding="5,10">

                    <HorizontalStackLayout
                        Grid.Column="0"
                        Spacing="5"
                        VerticalOptions="Center">

                        <BoxView Color="#287CF5"
                                 WidthRequest="9"
                                 HeightRequest="34"
                                 Rotation="35"/>

                        <BoxView Color="#287CF5"
                                 WidthRequest="9"
                                 HeightRequest="34"
                                 Rotation="35"/>

                    </HorizontalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="0"
                        VerticalOptions="Center">

                        <Label Text="REESTR"
                               TextColor="#FFFFFF"
                               FontSize="25"
                               FontAttributes="Bold"/>

                        <Label Text="Объявления"
                               TextColor="#A1A1AA"
                               FontSize="14"/>

                    </VerticalStackLayout>

                </Grid>

                <Border BackgroundColor="#151515"
                        Stroke="#383838"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="18">

                    <Grid RowDefinitions="Auto,1,Auto"
                          RowSpacing="22">

                        <Grid Grid.Row="0"
                              ColumnDefinitions="100,*"
                              ColumnSpacing="16">

                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    HeightRequest="100"
                                    WidthRequest="100"
                                    VerticalOptions="Center">

                                <Image Source="profile.png"
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="100"/>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Label Text="Polvoker"
                                       TextColor="#FFFFFF"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>

                                <Label Text="polvoker@mail.com"
                                       TextColor="#A1A1AA"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"/>

                                <Button Text="✎  Редактировать профиль"
                                        BackgroundColor="#287CF5"
                                        TextColor="#FFFFFF"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        Padding="10,12"
                                        Margin="0,8,0,0"/>

                            </VerticalStackLayout>

                        </Grid>

                        <BoxView Grid.Row="1"
                                 HeightRequest="1"
                                 BackgroundColor="#333333"/>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,1,*"
                              ColumnSpacing="20"
                              Padding="8,0">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label Text="12"
                                       TextColor="White"
                                       FontSize="30"
                                       FontAttributes="Bold"/>

                                <Label Text="Объявлений"
                                       TextColor="#A1A1AA"
                                       FontSize="15"/>

                            </VerticalStackLayout>

                            <BoxView Grid.Column="1"
                                     BackgroundColor="#333333"
                                     WidthRequest="1"/>

                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3">

                                <Label Text="2 481"
                                       TextColor="White"
                                       FontSize="30"
                                       FontAttributes="Bold"/>

                                <Label Text="Просмотров"
                                       TextColor="#A1A1AA"
                                       FontSize="15"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Grid>

                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <Label Grid.Column="0"
                           Text="Мои объявления"
                           TextColor="White"
                           FontSize="25"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#151515"
                            Stroke="#333333"
                            StrokeShape="RoundRectangle 14"
                            WidthRequest="48"
                            HeightRequest="48">

                        <Label Text="⌕"
                               TextColor="White"
                               FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                    </Border>

                </Grid>

                <VerticalStackLayout Spacing="12">

                    <Border BackgroundColor="#151515"
                            Stroke="#333333"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">

                        <Grid ColumnDefinitions="88,*,Auto"
                              ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    HeightRequest="88"
                                    WidthRequest="88">

                                <Image Source="channels4_profile.jpg"
                                       Aspect="AspectFill"/>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label Text="Ищим CEO для NVDIA (желательно кореец)"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>

                                <Label Text="чашка риса"
                                       TextColor="#3B82F6"
                                       FontSize="19"
                                       FontAttributes="Bold"/>

                                <Label Text="◉  342"
                                       TextColor="#A1A1AA"
                                       FontSize="14"/>

                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="•••"
                                   TextColor="White"
                                   FontSize="20"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                    <Border BackgroundColor="#151515"
                            Stroke="#333333"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">

                        <Grid ColumnDefinitions="88,*,Auto"
                              ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    HeightRequest="88"
                                    WidthRequest="88">

                                <Image Source="images.jpeg"
                                       Aspect="AspectFill"/>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label Text="Стартап 'Спасибо' баллы"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"/>

                                <Label Text="спасибо в карман положишь"
                                       TextColor="#3B82F6"
                                       FontSize="19"
                                       FontAttributes="Bold"/>

                                <Label Text="◉  1 204"
                                       TextColor="#A1A1AA"
                                       FontSize="14"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="•••"
                                   TextColor="White"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="0,12,0,0">

            <Button Grid.Column="1"
                    Text="+"
                    BackgroundColor="#287CF5"
                    TextColor="White"
                    FontSize="38"
                    CornerRadius="18"
                    WidthRequest="70"
                    HeightRequest="70"
                    Padding="0"/>

        </Grid>

    </Grid>

</ContentPage>
